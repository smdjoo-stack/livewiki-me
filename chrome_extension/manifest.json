{
  "manifest_version": 3,
  "name": "나만의 라이브위키",
  "version": "0.5.0",
  "description": "유튜브 영상과 뉴스·블로그 글을 Claude로 요약해서 옆 패널에 보여줍니다 (개인용).",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging", "storage", "tabs", "scripting", "activeTab", "contextMenus"],
  "host_permissions": ["https://www.youtube.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "라이브위키 요약 패널 열기" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
